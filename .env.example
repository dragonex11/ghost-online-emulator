# Copy to .env and fill in real values. Never commit .env.

# MySQL
# Local:  mysql://root:password@127.0.0.1:3306/ghostonline
# Cloud:  mysql://USER:PASSWORD@HOST:PORT/DATABASE  + MYSQL_SSL=1
DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/ghostonline
MYSQL_SSL=0

LOGIN_HOST=127.0.0.1
LOGIN_PORT=15001
CHANNEL_HOST=127.0.0.1
CHANNEL_PORT=15013
FIELD_HOST=127.0.0.1
FIELD_PORT=15023
UDP_PORT=13997
MESSENGER_PORT=17201
MESSENGER_PORT_ALT=13070

PKT_LOG=0

# Game data directory (relative to this package root)
DATA_DIR=data

# Optional rate overrides (defaults live in rates.json)
# KILL_EXP_RATE=1.0
# LEVEL_EXP_CURVE=1.19
# DROP_RATE=1.0
# GOLD_RATE=1.0
# MONSTER_RESPAWN_MS=20000
